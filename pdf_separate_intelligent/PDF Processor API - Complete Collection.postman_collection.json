                  "}",
                  "if (!pm.environment.get('task_id')) {",
                  "    pm.environment.set('task_id', '');",
                  "}",
                  "if (!pm.environment.get('employee_id')) {",
                  "    pm.environment.set('employee_id', '');",
                  "}",
                  "if (!pm.environment.get('encrypted_filename')) {",
                  "    pm.environment.set('encrypted_filename', '');",
